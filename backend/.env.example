# Copy this file to .env and add the API key for your hosted AI provider.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# NVIDIA NIM is preferred when configured. Store the real key only in a local
# .env file or the deployment's secret environment settings.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
